---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import art from '../assets/illustration/mascot_head.png';
---

<Base lang="id" page="home" title="Halaman tidak ditemukan — Tanukonomy" description="Halaman yang kamu cari tidak ada.">
  <section class="wrap nf">
    <Image src={art} alt="" width={144} class="pixel" />
    <h1>Halaman ini tidak ada di buku kas.</h1>
    <p class="lead">Tanuki sudah mencari di semua dompet, tapi tautannya tidak ditemukan. <span lang="en">Page not found.</span></p>
    <a class="btn btn-primary" href="/">Kembali ke beranda</a>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    justify-items: start;
    gap: 20px;
    padding-block: clamp(56px, 10vw, 120px);
    max-width: 720px;
  }
</style>
