---
import Base from '../layouts/Base.astro';
import ClayIcon from './ClayIcon.astro';
import { CONTACT_EMAIL, playUrl } from '../config';
import { type Lang, t } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const b = d.download;
---

<Base lang={lang} page="download" title={b.metaTitle} description={b.metaDescription}>
  <section class="intro">
    <div class="wrap intro-grid">
      <div>
        <span class="label">{b.eyebrow}</span>
        <h1>{b.title}</h1>
        <p class="lead">{b.body}</p>
        <a class="btn btn-primary store" href={playUrl(lang)} target="_blank" rel="noopener">
          {b.action}
          <span class="visually-hidden">{lang === 'id' ? '(tab baru)' : '(new tab)'}</span>
        </a>
      </div>
      <div class="card needs">
        <h2 class="label">{b.needLabel}</h2>
        <ul class="check-list">
          {b.needs.map((n) => <li>{n}</li>)}
        </ul>
        <ClayIcon name="tanuki_mascot" size={120} class="needs-art" eager />
      </div>
    </div>
  </section>

  <section class="section steps" aria-labelledby="steps-title">
    <div class="wrap">
      <h2 id="steps-title" class="label">{b.stepsLabel}</h2>
      <ol class="step-list" role="list">
        {
          b.steps.map((s, i) => (
            <li class="card step">
              <span class="num" aria-hidden="true">
                {i + 1}
              </span>
              <div class="step-body">
                <h3>{s.t}</h3>
                <p>{s.d}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section plus" aria-labelledby="plus-title">
    <div class="wrap">
      <h2 id="plus-title" class="label">{b.plusLabel}</h2>
      <div class="card note">
        <p>{b.plusBody}</p>
        <p class="privacy-note">
          <ClayIcon name="shield_emergency" size={28} />
          <span>{b.privacyNote}</span>
        </p>
        <p>
          {b.feedback} <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>{' '}{b.feedbackPlay}
        </p>
      </div>
    </div>
  </section>

  <section class="section trouble" aria-labelledby="trouble-title">
    <div class="wrap">
      <span class="label">{b.troubleLabel}</span>
      <h2 id="trouble-title">{b.troubleTitle}</h2>
      <div class="trouble-list">
        {
          b.trouble.map((item) => (
            <details class="card">
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .intro {
    padding-block: clamp(40px, 7vw, 88px);
    border-bottom: var(--border);
  }
  .intro-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(32px, 6vw, 72px);
    align-items: center;
  }
  h1 {
    font-size: clamp(2rem, 4.6vw, 3.25rem);
    margin-bottom: 20px;
  }
  .store {
    margin-top: 32px;
  }
  .needs {
    padding: 28px;
    display: grid;
  }
  .needs :global(.needs-art) {
    justify-self: end;
    margin: 12px 0 -28px;
  }
  .steps {
    background: var(--bg-sunk);
    border-block: var(--border);
  }
  .step-list {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    display: grid;
    gap: 18px;
  }
  .step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 20px;
    align-items: center;
    padding: 24px;
  }
  .num {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.25rem;
    background: var(--tint-income);
    color: var(--income);
    border-radius: 50%;
  }
  .step h3 {
    margin-bottom: 6px;
  }
  .step p {
    color: var(--muted);
    max-width: 62ch;
  }
  .note {
    margin-top: 24px;
    padding: 24px;
    display: grid;
    gap: 14px;
  }
  .note a {
    font-weight: 700;
    color: var(--accent);
  }
  .privacy-note {
    display: flex;
    gap: 12px;
    align-items: center;
    color: var(--muted);
  }
  .trouble h2 {
    margin: 12px 0 32px;
  }
  .trouble-list {
    display: grid;
    gap: 14px;
    max-width: 860px;
  }
  summary {
    cursor: pointer;
    list-style: none;
    padding: 20px 56px 20px 22px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    position: relative;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    position: absolute;
    right: 20px;
    top: 50%;
    translate: 0 -50%;
    font-family: var(--font-mono);
    font-size: 1.375rem;
    color: var(--accent);
  }
  details[open] summary::after {
    content: '−';
  }
  details p {
    padding: 0 22px 22px;
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .intro-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
