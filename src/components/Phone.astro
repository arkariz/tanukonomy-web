---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Lang } from '../i18n';

interface Props {
  screen: string;
  lang: Lang;
  alt: string;
  eager?: boolean;
  /** Paksa satu varian tema; bawaan mengikuti prefers-color-scheme. */
  theme?: 'light' | 'dark';
  class?: string;
}

const { screen, lang, alt, eager = false, theme, class: cls } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/screens/*.png', { eager: true });
const find = (variant: string) => files[`../assets/screens/${screen}-${variant}.png`]?.default;

const light = find(`${lang}-light`) ?? find('id-light');
const dark = find(`${lang}-dark`);
if (!light) throw new Error(`Tangkapan layar tidak ditemukan: ${screen}`);

const widths = [360, 720];
const sizes = '(max-width: 640px) 72vw, 340px';
const build = (src: ImageMetadata, format: 'avif' | 'webp') =>
  getImage({ src, widths, sizes, format, quality: format === 'avif' ? 60 : 78 });

const base = theme === 'dark' && dark ? dark : light;
const [lAvif, lWebp] = await Promise.all([build(base, 'avif'), build(base, 'webp')]);
const darkSet = !theme && dark ? await Promise.all([build(dark, 'avif'), build(dark, 'webp')]) : null;
---

<figure class:list={['phone', cls]}>
  <picture>
    {darkSet && <source media="(prefers-color-scheme: dark)" type="image/avif" srcset={darkSet[0].srcSet.attribute} sizes={sizes} />}
    {darkSet && <source media="(prefers-color-scheme: dark)" type="image/webp" srcset={darkSet[1].srcSet.attribute} sizes={sizes} />}
    <source type="image/avif" srcset={lAvif.srcSet.attribute} sizes={sizes} />
    <img
      src={lWebp.src}
      srcset={lWebp.srcSet.attribute}
      sizes={sizes}
      alt={alt}
      width={390}
      height={844}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding="async"
    />
  </picture>
</figure>

<style>
  .phone {
    margin: 0;
    width: min(100%, 340px);
    padding: 10px;
    background: var(--edge);
    border-radius: 36px;
    box-shadow: 8px 8px 0 color-mix(in srgb, var(--edge) 35%, transparent);
  }
  .phone img {
    width: 100%;
    height: auto;
    border-radius: 27px;
    background: var(--card);
  }
</style>
