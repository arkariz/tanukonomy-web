---
import Base from '../layouts/Base.astro';
import ClayIcon from './ClayIcon.astro';
import Shot from './Shot.astro';
import { APP_NAME, PLAY_STORE_URL, SITE_URL, playUrl } from '../config';
import { type Lang, path, t } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);

const questionIcons = ['bank_wallet', 'receipt_bills', 'chart_investment'];
const privacyIcons = ['shield_emergency', 'bank_wallet', 'check_completed', 'wifi_internet'];
const upcomingIcons = ['scan_camera', 'report_bars', 'family_people'];
const freelanceIcons = ['clipboard_worklog', 'doc_invoice', 'coin_paid'];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    name: APP_NAME,
    operatingSystem: 'Android 6.0+',
    installUrl: PLAY_STORE_URL,
    downloadUrl: PLAY_STORE_URL,
    applicationCategory: 'FinanceApplication',
    description: d.meta.description,
    inLanguage: ['id', 'en'],
    url: new URL(path('home', lang), SITE_URL).href,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'IDR' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faq.items.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Base lang={lang} page="home" title={d.meta.title} description={d.meta.description} jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="label">{d.hero.eyebrow}</span>
        <h1>{d.hero.title}</h1>
        <p class="lead">{d.hero.body}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={playUrl(lang)} target="_blank" rel="noopener">
            {d.hero.primary}
            <span class="visually-hidden">{lang === 'id' ? '(tab baru)' : '(new tab)'}</span>
          </a>
          <a class="link-tertiary" href="#fitur">{d.hero.secondary}</a>
        </div>
        <ul class="chips" role="list">
          {d.hero.chips.map((c) => <li>{c}</li>)}
        </ul>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <div class="hero-orb">
          <ClayIcon name="tanuki_mascot" size={280} class="hero-tanuki" eager />
          <ClayIcon name="piggy_savings" size={76} class="float f1" />
          <ClayIcon name="cash_wallet" size={68} class="float f2" />
          <ClayIcon name="chart_investment" size={72} class="float f3" />
          <ClayIcon name="tier_coin" size={56} class="float f4" />
          <ClayIcon name="check_completed" size={52} class="float f5" />
        </div>
      </div>
    </div>
  </section>

  <!-- Tiga pertanyaan -->
  <section class="section questions" aria-labelledby="q-title">
    <div class="wrap">
      <span class="label">{d.questions.label}</span>
      <h2 id="q-title">{d.questions.title}</h2>
      <ol class="q-grid" role="list">
        {
          d.questions.items.map((q, i) => (
            <li class="card q-card">
              <div class="q-head">
                <span class="tile q-icon">
                  <ClayIcon name={questionIcons[i]} size={36} />
                </span>
                <span class="q-num">0{i + 1}</span>
              </div>
              <h3>{q.q}</h3>
              <p>{q.a}</p>
              <span class="q-tag">{q.tag}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Fitur -->
  <section id="fitur" class="section features" aria-labelledby="f-title">
    <div class="wrap">
      <div class="section-head">
        <span class="label">{d.features.label}</span>
        <h2 id="f-title">{d.features.title}</h2>
      </div>
      {
        d.features.items.map((f, i) => (
          <article class:list={['feature', { flip: i % 2 === 1 }]} id={f.id}>
            <div class="feature-copy">
              <span class="pill">{f.tag}</span>
              <h3>{f.title}</h3>
              <p class="lead">{f.body}</p>
              <ul class="check-list">
                {f.points.map((p) => <li>{p}</li>)}
              </ul>
            </div>
            <div class="feature-visual">
              <Shot shot={f.shot} lang={lang} alt={f.shotAlt} />
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Freelance -->
  <section id="freelance" class="section freelance" aria-labelledby="fl-title">
    <div class="wrap fl-grid">
      <div>
        <span class="label">{d.freelance.label}</span>
        <h2 id="fl-title">{d.freelance.title}</h2>
        <p class="lead">{d.freelance.body}</p>
        <dl class="ledger card">
          {
            d.freelance.points.map((p, i) => (
              <div class="ledger-row">
                <dt>
                  <ClayIcon name={freelanceIcons[i]} size={32} />
                  {p.k}
                </dt>
                <dd>{p.v}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div class="fl-visual">
        <Shot shot={d.freelance.shot} lang={lang} alt={d.freelance.shotAlt} />
      </div>
    </div>
  </section>

  <!-- Plus -->
  <section id="plus" class="section plus" aria-labelledby="plus-title">
    <div class="wrap">
      <div class="section-head">
        <span class="label">{d.plus.label}</span>
        <h2 id="plus-title">{d.plus.title}</h2>
        <p class="lead">{d.plus.body}</p>
      </div>
      <div class="plus-grid">
        <div class="card plan">
          <h3><ClayIcon name="check_completed" size={32} />{d.plus.freeLabel}</h3>
          <ul class="check-list">
            {d.plus.free.map((f) => <li>{f}</li>)}
          </ul>
        </div>
        <div class="card plan plan-plus">
          <h3><ClayIcon name="tier_coin" size={32} />{d.plus.plusLabel}</h3>
          <ul class="check-list">
            {d.plus.plus.map((f) => <li>{f}</li>)}
          </ul>
        </div>
      </div>
      <p class="plus-note">{d.plus.note}</p>
    </div>
  </section>

  <!-- Privasi -->
  <section id="privasi" class="section privacy" aria-labelledby="p-title">
    <div class="wrap">
      <div class="privacy-head">
        <span class="label">{d.privacy.label}</span>
        <h2 id="p-title">{d.privacy.title}</h2>
        <p class="lead">{d.privacy.body}</p>
      </div>
      <ul class="p-grid" role="list">
        {
          d.privacy.items.map((p, i) => (
            <li class="p-item">
              <span class="p-icon">
                <ClayIcon name={privacyIcons[i]} size={34} />
              </span>
              <h3>{p.t}</h3>
              <p>{p.d}</p>
            </li>
          ))
        }
      </ul>
      <p class="p-future">
        <ClayIcon name="note_pencil" size={26} />
        <span>{d.privacy.smart}</span>
      </p>
      <a class="p-link" href={path('privacy', lang)}>{d.privacy.link} →</a>
    </div>
  </section>

  <!-- Fitur mendatang -->
  <section id="mendatang" class="section upcoming" aria-labelledby="u-title">
    <div class="wrap">
      <div class="section-head">
        <span class="label">{d.upcoming.label}</span>
        <h2 id="u-title">{d.upcoming.title}</h2>
        <p class="lead">{d.upcoming.body}</p>
      </div>
      <ul class="u-grid" role="list">
        {
          d.upcoming.items.map((u, i) => (
            <li class="u-card">
              <div class="u-head">
                <span class="tile u-icon">
                  <ClayIcon name={upcomingIcons[i]} size={36} />
                </span>
                <span class="u-badge">{d.upcoming.badge}</span>
              </div>
              <h3>{u.t}</h3>
              <p>{u.d}</p>
            </li>
          ))
        }
      </ul>
      <p class="u-note">
        <ClayIcon name="hourglass_pending" size={24} />
        <span>
          {d.upcoming.note} <a href={path('privacy', lang)}>{d.upcoming.link} →</a>
        </span>
      </p>
    </div>
  </section>

  <!-- Mode gelap -->
  <section class="section dark-mode" aria-labelledby="d-title">
    <div class="wrap dm-grid">
      <div>
        <span class="label">{d.dark.label}</span>
        <h2 id="d-title">{d.dark.title}</h2>
        <p class="lead">{d.dark.body}</p>
      </div>
      <div class="dm-pair" aria-hidden="true">
        <div class="swatch swatch-light">
          <span class="sw-hero"></span>
          <span class="sw-row"></span>
          <span class="sw-row short"></span>
          <span class="sw-btn"></span>
          <span class="sw-name">{d.dark.light}</span>
        </div>
        <div class="swatch swatch-dark">
          <span class="sw-hero"></span>
          <span class="sw-row"></span>
          <span class="sw-row short"></span>
          <span class="sw-btn"></span>
          <span class="sw-name">{d.dark.night}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Cara mulai -->
  <section class="section steps" aria-labelledby="s-title">
    <div class="wrap">
      <span class="label">{d.steps.label}</span>
      <h2 id="s-title">{d.steps.title}</h2>
      <ol class="s-grid" role="list">
        {
          d.steps.items.map((s, i) => (
            <li>
              <span class="s-num" aria-hidden="true">
                {i + 1}
              </span>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Tanya jawab -->
  <section id="tanya-jawab" class="section faq" aria-labelledby="faq-title">
    <div class="wrap faq-grid">
      <div>
        <span class="label">{d.faq.label}</span>
        <h2 id="faq-title">{d.faq.title}</h2>
      </div>
      <div class="faq-list">
        {
          d.faq.items.map((f) => (
            <details class="card">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta-section" aria-labelledby="cta-title">
    <div class="wrap">
      <div class="cta card">
        <div class="cta-copy">
          <h2 id="cta-title">{d.cta.title}</h2>
          <p class="lead">{d.cta.body}</p>
          <a class="btn btn-primary" href={playUrl(lang)} target="_blank" rel="noopener">
            {d.cta.primary}
            <span class="visually-hidden">{lang === 'id' ? '(tab baru)' : '(new tab)'}</span>
          </a>
        </div>
        <ClayIcon name="tanuki_mascot" size={200} class="cta-art" />
      </div>
    </div>
  </section>
</Base>


<style>
  /* Hero: kanvas kabut dengan cahaya sage lembut, tanpa garis kertas. */
  .hero {
    padding-block: clamp(40px, 7vw, 96px) clamp(64px, 9vw, 120px);
    background:
      radial-gradient(60% 70% at 88% 18%, color-mix(in srgb, var(--tint-income) 75%, transparent), transparent 70%),
      var(--bg);
    border-bottom: var(--border);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }
  .hero h1 {
    margin-bottom: 20px;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-top: 32px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    padding: 0;
    margin: 32px 0 0;
  }
  .chips li {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.8125rem;
    padding: 6px 14px;
    background: var(--card);
    border: var(--border);
    border-radius: var(--radius-pill);
  }
  .hero-visual {
    display: flex;
    justify-content: center;
  }
  .hero-orb {
    position: relative;
    width: min(100%, 420px);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, var(--card), var(--tint-income) 78%);
    border: var(--border);
    box-shadow: var(--shadow-lg);
  }
  .hero-orb :global(.hero-tanuki) {
    width: 68%;
    height: auto;
    filter: drop-shadow(0 12px 16px rgb(17 24 39 / 0.18));
  }
  .hero-orb :global(.float) {
    position: absolute;
    filter: drop-shadow(0 6px 8px rgb(17 24 39 / 0.18));
  }
  .hero-orb :global(.f1) {
    left: 4%;
    top: 12%;
  }
  .hero-orb :global(.f2) {
    right: 2%;
    top: 22%;
  }
  .hero-orb :global(.f3) {
    left: 8%;
    bottom: 10%;
  }
  .hero-orb :global(.f4) {
    right: 14%;
    bottom: 6%;
  }
  .hero-orb :global(.f5) {
    left: 42%;
    top: -2%;
  }

  /* Tiga pertanyaan --------------------------------------------------- */
  .q-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    padding: 0;
    margin: 48px 0 0;
    list-style: none;
  }
  .q-card {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .q-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }
  .q-num {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--muted);
  }
  .q-card p {
    color: var(--muted);
    flex: 1;
  }
  .q-tag {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
  }

  /* Fitur ------------------------------------------------------------- */
  .features {
    background: var(--bg-sunk);
    border-block: var(--border);
  }
  .section-head {
    max-width: 720px;
    margin-bottom: clamp(40px, 6vw, 72px);
  }
  .feature {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
    padding-block: clamp(32px, 5vw, 56px);
  }
  .feature + .feature {
    border-top: 1px solid var(--divider);
  }
  .feature.flip .feature-copy {
    order: 2;
  }
  .feature-copy h3 {
    font-size: clamp(1.625rem, 2.8vw, 2.25rem);
    font-weight: 700;
    margin: 14px 0 16px;
  }
  .feature-copy .lead {
    margin-bottom: 24px;
  }
  .feature-visual {
    display: flex;
    justify-content: center;
  }

  /* Freelance --------------------------------------------------------- */
  .fl-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }
  .fl-grid h2 {
    margin-bottom: 20px;
  }
  .ledger {
    margin: 32px 0 0;
    padding: 8px 24px;
  }
  .ledger-row {
    padding-block: 16px;
  }
  .ledger-row + .ledger-row {
    border-top: 1px solid var(--divider);
  }
  dt {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
  }
  dd {
    margin: 2px 0 0 46px;
    color: var(--muted);
  }
  .fl-visual {
    display: flex;
    justify-content: center;
  }

  /* Privasi: pita hijau hutan seperti kartu saldo di aplikasi --------- */
  .privacy {
    background: var(--band);
    color: var(--on-band);
  }
  .privacy .label,
  .privacy .p-link {
    color: var(--on-band-accent);
  }
  .privacy .lead {
    color: var(--on-band-muted);
  }
  .privacy-head {
    max-width: 720px;
  }
  .privacy-head h2 {
    margin-bottom: 20px;
  }
  .p-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    list-style: none;
    padding: 0;
    margin: 56px 0 40px;
  }
  .p-item {
    padding: 24px;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: var(--radius-card);
    background: rgb(255 255 255 / 0.08);
  }
  .p-icon {
    display: inline-grid;
    place-items: center;
    width: 52px;
    height: 52px;
    background: rgb(255 255 255 / 0.92);
    border-radius: 12px;
    margin-bottom: 18px;
  }
  .p-item h3 {
    font-size: 1.1875rem;
    margin-bottom: 8px;
  }
  .p-item p {
    color: var(--on-band-muted);
    font-size: 0.975rem;
  }
  .p-future {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    max-width: 68ch;
    padding: 16px 18px;
    margin-bottom: 24px;
    background: rgb(255 255 255 / 0.08);
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: var(--radius-card);
    color: var(--on-band-muted);
    font-size: 0.975rem;
  }
  .p-future :global(img) {
    flex: none;
  }
  .p-link {
    font-family: var(--font-display);
    font-weight: 700;
    text-underline-offset: 4px;
  }

  /* Plus --------------------------------------------------------------- */
  .plus-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    max-width: 920px;
  }
  .plan {
    padding: 28px;
    display: grid;
    gap: 18px;
    align-content: start;
  }
  .plan h3 {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .plan-plus {
    border-color: var(--accent);
  }
  .plus-note {
    margin-top: 24px;
    max-width: 68ch;
    color: var(--muted);
  }

  /* Rencana ------------------------------------------------------------- */
  .u-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    max-width: 920px;
    gap: 24px;
    padding: 0;
    margin: 48px 0 32px;
    list-style: none;
  }
  .u-card {
    padding: 28px;
    background: var(--card);
    border: var(--border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .u-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }
  .u-badge {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 5px 12px;
    color: var(--on-tint-warm);
    background: var(--tint-warm);
    border-radius: var(--radius-pill);
  }
  .u-card h3 {
    font-size: 1.1875rem;
  }
  .u-card p {
    color: var(--muted);
    flex: 1;
  }
  .u-note {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    max-width: 74ch;
    padding: 14px 18px;
    background: var(--tint-pending);
    border-radius: var(--radius-card);
    color: var(--pending-on-tint);
  }
  .u-note :global(img) {
    flex: none;
  }
  .u-note a {
    font-weight: 700;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Tampilan: pratinjau palet terang dan gelap -------------------------- */
  .dm-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }
  .dm-grid h2 {
    margin-bottom: 20px;
  }
  .dm-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .swatch {
    --sw-bg: #fafaf9;
    --sw-card: #ffffff;
    --sw-line: #eaecef;
    --sw-text: #111827;
    --sw-accent: #1f4b2c;
    --sw-on-accent: #ffffff;
    position: relative;
    display: grid;
    gap: 12px;
    padding: 18px 18px 52px;
    background: var(--sw-bg);
    color: var(--sw-text);
    border: 1px solid var(--sw-line);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
  }
  .swatch-dark {
    --sw-bg: #0f1210;
    --sw-card: #171b18;
    --sw-line: #2a302c;
    --sw-text: #eef1ee;
    --sw-accent: #a2d2a9;
    --sw-on-accent: #00210c;
  }
  .sw-hero {
    display: block;
    height: 96px;
    border-radius: var(--radius-card);
    background: #1f4b2c;
  }
  .sw-row {
    display: block;
    height: 36px;
    border-radius: var(--radius);
    background: var(--sw-card);
    border: 1px solid var(--sw-line);
  }
  .sw-row.short {
    width: 70%;
  }
  .sw-btn {
    display: block;
    height: 40px;
    border-radius: var(--radius);
    background: var(--sw-accent);
  }
  .sw-name {
    position: absolute;
    left: 18px;
    bottom: 16px;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Langkah ----------------------------------------------------------- */
  .steps {
    background: var(--bg-sunk);
    border-block: var(--border);
  }
  .s-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    list-style: none;
    padding: 0;
    margin: 48px 0 0;
  }
  .s-num {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
