---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PixelIcon from './PixelIcon.astro';
import art from '../assets/illustration/onboarding_5.png';
import { CONTACT_EMAIL, GOOGLE_GROUP_URL, PLAY_STORE_URL, PLAY_TESTING_URL } from '../config';
import { type Lang, t } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const b = d.beta;
const urls = [GOOGLE_GROUP_URL, PLAY_TESTING_URL, PLAY_STORE_URL];
const open = GOOGLE_GROUP_URL !== '' && PLAY_TESTING_URL !== '';
// Tombol utama hanya satu per layar (ADR-020): langkah pertama yang belum
// dikerjakan penguji; langkah berikutnya bergaya sekunder.
const btnClass = (i: number) => (i === 0 ? 'btn btn-primary' : 'btn btn-secondary');
---

<Base lang={lang} page="beta" title={b.metaTitle} description={b.metaDescription}>
  <section class="intro">
    <div class="wrap intro-grid">
      <div>
        <span class="label">{b.eyebrow}</span>
        <h1>{b.title}</h1>
        <p class="lead">{b.body}</p>
      </div>
      <div class="card needs">
        <h2 class="label">{b.needLabel}</h2>
        <ul class="check-list">
          {b.needs.map((n) => <li>{n}</li>)}
        </ul>
        <Image src={art} alt="" width={180} class="pixel needs-art" loading="eager" />
      </div>
    </div>
  </section>

  <section class="section steps" aria-labelledby="steps-title">
    <div class="wrap">
      <h2 id="steps-title" class="label">{b.stepsLabel}</h2>
      {!open && <p class="soon-note" role="status">{b.soonNote}</p>}
      <ol class="step-list" role="list">
        {
          b.steps.map((s, i) => (
            <li class="card step">
              <span class="num" aria-hidden="true">
                {i + 1}
              </span>
              <div class="step-body">
                <h3>{s.t}</h3>
                <p>{s.d}</p>
              </div>
              {s.action &&
                (urls[i] ? (
                  <a class={btnClass(i)} href={urls[i]} target="_blank" rel="noopener">
                    {s.action}
                    <span class="visually-hidden">{lang === 'id' ? '(tab baru)' : '(new tab)'}</span>
                  </a>
                ) : (
                  <span class="btn" aria-disabled="true">
                    {b.soon}
                  </span>
                ))}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section asks" aria-labelledby="asks-title">
    <div class="wrap">
      <h2 id="asks-title">{b.askLabel}</h2>
      <ul class="ask-grid" role="list">
        {
          b.asks.map((a, i) => (
            <li>
              <span class="ask-icon">
                <PixelIcon name={['pending', 'transactions', 'check'][i]} size={32} />
              </span>
              <h3>{a.t}</h3>
              <p>{a.d}</p>
            </li>
          ))
        }
      </ul>
      <div class="card note">
        <p>
          {b.feedback} <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>{' '}{b.feedbackPlay}
        </p>
        <p class="privacy-note">
          <PixelIcon name="locked" size={24} />
          <span>{b.privacyNote}</span>
        </p>
      </div>
    </div>
  </section>

  <section class="section trouble" aria-labelledby="trouble-title">
    <div class="wrap">
      <span class="label">{b.troubleLabel}</span>
      <h2 id="trouble-title">{b.troubleTitle}</h2>
      <div class="trouble-list">
        {
          b.trouble.map((item) => (
            <details class="card">
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .intro {
    padding-block: clamp(40px, 7vw, 88px);
    border-bottom: var(--border);
  }
  .intro-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(32px, 6vw, 72px);
    align-items: center;
  }
  h1 {
    font-size: clamp(2rem, 4.6vw, 3.25rem);
    margin-bottom: 20px;
  }
  .needs {
    padding: 28px;
    display: grid;
  }
  .needs-art {
    justify-self: end;
    width: 130px;
    height: auto;
    margin: 12px 0 -28px;
  }
  .soon-note {
    padding: 14px 18px;
    border: 2px dashed var(--pending);
    border-radius: var(--radius);
    background: var(--tint-pending);
    margin-bottom: 24px;
    max-width: 72ch;
  }
  .step-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 18px;
  }
  .step {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 20px;
    align-items: center;
    padding: 24px;
  }
  .num {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.25rem;
    background: var(--tint-accent);
    color: var(--accent);
    border: var(--border);
    border-radius: 4px;
  }
  .step h3 {
    margin-bottom: 6px;
  }
  .step p {
    color: var(--muted);
    max-width: 62ch;
  }
  .asks {
    background: var(--bg-sunk);
    border-top: var(--border);
  }
  .ask-grid {
    list-style: none;
    padding: 0;
    margin: 40px 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .ask-icon {
    display: inline-grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: var(--border);
    border-radius: 4px;
    background: var(--card);
    margin-bottom: 16px;
  }
  .ask-grid h3 {
    margin-bottom: 8px;
  }
  .ask-grid p {
    color: var(--muted);
  }
  .note {
    padding: 24px;
    display: grid;
    gap: 14px;
    box-shadow: none;
  }
  .note a {
    font-weight: 700;
    color: var(--accent);
  }
  .privacy-note {
    display: flex;
    gap: 12px;
    align-items: center;
    color: var(--muted);
  }
  .trouble h2 {
    margin: 12px 0 32px;
  }
  .trouble-list {
    display: grid;
    gap: 14px;
    max-width: 860px;
  }
  .trouble-list details {
    box-shadow: none;
  }
  .trouble-list details[open] {
    box-shadow: var(--shadow);
  }
  .trouble-list summary {
    cursor: pointer;
    list-style: none;
    padding: 20px 56px 20px 22px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.0625rem;
    position: relative;
  }
  .trouble-list summary::-webkit-details-marker {
    display: none;
  }
  .trouble-list summary::after {
    content: '+';
    position: absolute;
    right: 20px;
    top: 50%;
    translate: 0 -50%;
    font-family: var(--font-mono);
    font-size: 1.375rem;
    color: var(--accent);
  }
  .trouble-list details[open] summary::after {
    content: '−';
  }
  .trouble-list p {
    padding: 0 22px 22px;
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .intro-grid,
    .ask-grid {
      grid-template-columns: 1fr;
    }
    .step {
      grid-template-columns: auto 1fr;
    }
    .step .btn {
      grid-column: 1 / -1;
    }
  }
</style>
