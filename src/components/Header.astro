---
import Logo from './Logo.astro';
import { type Lang, type PageKey, otherLang, path, t } from '../i18n';

interface Props {
  lang: Lang;
  page: PageKey;
}
const { lang, page } = Astro.props;
const d = t(lang);
const home = path('home', lang);
const anchor = (id: string) => (page === 'home' ? `#${id}` : `${home}#${id}`);
const links = [
  { href: anchor('fitur'), label: d.nav.features },
  { href: anchor('freelance'), label: d.nav.freelance },
  { href: anchor('privasi'), label: d.nav.privacy },
  { href: anchor('tanya-jawab'), label: d.nav.faq },
];
---

<header class="header">
  <div class="wrap bar">
    <Logo href={home} />
    <nav aria-label={d.nav.menu}>
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="actions">
      <a class="lang" href={path(page, otherLang(lang))} hreflang={otherLang(lang)} lang={otherLang(lang)}>
        <span aria-hidden="true">{otherLang(lang).toUpperCase()}</span>
        <span class="visually-hidden">{d.nav.langLabel}</span>
      </a>
      {page !== 'beta' && <a class="btn btn-secondary cta" href={path('beta', lang)}>{d.nav.cta}</a>}
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 72px;
  }
  nav {
    margin-left: auto;
  }
  nav ul {
    display: flex;
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    font-weight: 600;
    text-decoration: none;
    font-size: 0.975rem;
  }
  nav a:hover {
    color: var(--accent);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .lang {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.875rem;
    min-width: 44px;
    min-height: 44px;
    display: inline-grid;
    place-items: center;
    text-decoration: none;
    border: var(--border);
    border-radius: var(--radius);
    background: var(--card);
  }
  .cta {
    min-height: 44px;
    padding: 0 18px;
    font-size: 0.975rem;
  }
  @media (max-width: 900px) {
    nav {
      display: none;
    }
    .actions {
      margin-left: auto;
    }
  }
  .cta {
    white-space: nowrap;
  }
  /* Di layar sempit tombol utama hero sudah terlihat; tombol kepala disembunyikan. */
  @media (max-width: 480px) {
    .cta {
      display: none;
    }
  }
</style>
