---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { APP_NAME, SITE_URL, withBase } from '../config';
import groteskUrl from '../assets/fonts/SpaceGrotesk-Variable.woff2?url';
import jakartaUrl from '../assets/fonts/PlusJakartaSans-Variable.woff2?url';
import { type Lang, type PageKey, htmlLang, ogLocale, otherLang, path, t } from '../i18n';

interface Props {
  lang: Lang;
  page: PageKey;
  title: string;
  description: string;
  jsonLd?: object[];
  /** Jalur halaman ini bila bukan hasil path(page, lang), mis. artikel. */
  canonicalPath?: string;
  /** Jalur padanan di bahasa lain; null bila tidak ada, kosong = path(page, otherLang). */
  alternatePath?: string | null;
  ogType?: 'website' | 'article';
}

const { lang, page, title, description, jsonLd = [], canonicalPath, alternatePath, ogType = 'website' } = Astro.props;
const d = t(lang);
const canonical = new URL(canonicalPath ?? path(page, lang), SITE_URL).href;
const altPath = alternatePath === undefined ? path(page, otherLang(lang)) : alternatePath;
const alternate = altPath ? new URL(altPath, SITE_URL).href : null;
// x-default: versi Indonesia bila ada; kalau tidak, halaman ini sendiri.
const idUrl = lang === 'id' ? canonical : alternate;
const ogImage = new URL(withBase(`/og/og-${lang}.png`), SITE_URL).href;

const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: APP_NAME,
  url: new URL(path('home', 'id'), SITE_URL).href,
  logo: new URL(withBase('/icon-512.png'), SITE_URL).href,
};
---

<!doctype html>
<html lang={htmlLang(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={htmlLang(lang)} href={canonical} />
    {alternate && <link rel="alternate" hreflang={htmlLang(otherLang(lang))} href={alternate} />}
    <link rel="alternate" hreflang="x-default" href={idUrl ?? canonical} />

    <meta name="theme-color" content="#fff8f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#231f1b" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="32x32" />
    <link rel="icon" type="image/png" href={withBase('/icon-192.png')} sizes="192x192" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/site.webmanifest')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    <link rel="preload" href={groteskUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jakartaUrl} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={APP_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale(lang)} />
    {alternate && <meta property="og:locale:alternate" content={ogLocale(otherLang(lang))} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={d.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {[org, ...jsonLd].map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip" href="#isi">{d.nav.skip}</a>
    <Header lang={lang} page={page} altPath={altPath} />
    <main id="isi">
      <slot />
    </main>
    <Footer lang={lang} page={page} altPath={altPath} />
  </body>
</html>
