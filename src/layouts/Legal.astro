---
import Base from './Base.astro';
import { LEGAL_EFFECTIVE_DATE } from '../config';
import { type Lang, type PageKey, path, t } from '../i18n';

interface Props {
  lang: Lang;
  page: PageKey;
  title: string;
  description: string;
}
const { lang, page, title, description } = Astro.props;
const d = t(lang);
const date = new Date(`${LEGAL_EFFECTIVE_DATE}T00:00:00`).toLocaleDateString(lang === 'id' ? 'id-ID' : 'en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Base lang={lang} page={page} title={`${title} — Tanukonomy`} description={description}>
  <article class="wrap legal">
    <a class="back" href={path('home', lang)}>← {d.legal.back}</a>
    <h1>{title}</h1>
    <p class="effective">{d.legal.effective} <time datetime={LEGAL_EFFECTIVE_DATE}>{date}</time></p>
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>

<style>
  .legal {
    max-width: 780px;
    padding-block: clamp(40px, 7vw, 88px);
  }
  .back {
    font-weight: 700;
    text-decoration: none;
    color: var(--accent);
  }
  h1 {
    font-size: clamp(2rem, 4.4vw, 3rem);
    margin: 24px 0 12px;
  }
  .effective {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.8125rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding-bottom: 28px;
    border-bottom: var(--border);
  }
  .prose :global(h2) {
    font-size: 1.5rem;
    margin: 44px 0 12px;
  }
  .prose :global(p),
  .prose :global(ul) {
    margin: 0 0 16px;
  }
  .prose :global(li) {
    margin-bottom: 8px;
  }
  .prose :global(a) {
    color: var(--accent);
    font-weight: 600;
  }
  .prose :global(strong) {
    font-weight: 700;
  }
  .prose :global(.lede) {
    font-size: 1.1875rem;
  }
</style>
