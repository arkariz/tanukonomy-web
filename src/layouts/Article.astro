---
import { Image, getImage } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import mascot from '../assets/illustration/mascot_head.png';
import { APP_NAME, SITE_URL } from '../config';
import { type Lang, articlePath, htmlLang, otherLang, path, t } from '../i18n';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'blog'>;
}
const { lang, entry } = Astro.props;
const d = t(lang);
const post = entry.data;
const { Content, headings } = await render(entry);

const toc = headings.filter((h) => h.depth === 2);
const minutes = Math.max(1, Math.ceil((entry.body ?? '').split(/\s+/).filter(Boolean).length / 200));
const fmt = (date: Date) =>
  date.toLocaleDateString(lang === 'id' ? 'id-ID' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const iso = (date: Date) => date.toISOString().slice(0, 10);
const showUpdated = iso(post.updatedDate) !== iso(post.publishedDate);

// Padanan di bahasa lain hanya bila artikelnya benar-benar ada (dan sudah terbit).
const other = otherLang(lang);
const siblings = await getCollection('blog', ({ data }) => data.lang === other && (import.meta.env.DEV || !data.draft));
const translation = post.translationOf ? siblings.find((e) => e.data.slug === post.translationOf) : undefined;
const alternatePath = translation ? articlePath(other, translation.data.slug) : null;

const canonicalPath = articlePath(lang, post.slug);
const url = new URL(canonicalPath, SITE_URL).href;
const cover = post.image
  ? await getImage({ src: post.image, width: 480, format: 'webp', quality: 90 })
  : undefined;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.title,
    description: post.description,
    inLanguage: htmlLang(lang),
    mainEntityOfPage: url,
    datePublished: iso(post.publishedDate),
    dateModified: iso(post.updatedDate),
    author: { '@type': 'Organization', name: APP_NAME, url: new URL(path('home', 'id'), SITE_URL).href },
    publisher: { '@type': 'Organization', name: APP_NAME },
    ...(cover ? { image: new URL(cover.src, SITE_URL).href } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: d.blog.breadcrumbHome, item: new URL(path('home', lang), SITE_URL).href },
      { '@type': 'ListItem', position: 2, name: d.blog.label, item: new URL(path('blog', lang), SITE_URL).href },
      { '@type': 'ListItem', position: 3, name: post.title, item: url },
    ],
  },
];
---

<Base
  lang={lang}
  page="blog"
  title={`${post.title} — ${APP_NAME}`}
  description={post.description}
  jsonLd={jsonLd}
  canonicalPath={canonicalPath}
  alternatePath={alternatePath}
  ogType="article"
>
  <article class="wrap art">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={path('home', lang)}>{d.blog.breadcrumbHome}</a>
      <span aria-hidden="true">/</span>
      <a href={path('blog', lang)}>{d.blog.label}</a>
    </nav>

    <header class="head">
      <p class="label">{d.blog.label}</p>
      <h1>{post.title}</h1>
      <p class="meta">
        <span>{d.blog.by} {post.author}</span>
        <span aria-hidden="true">·</span>
        <time datetime={iso(post.publishedDate)}>{d.blog.published} {fmt(post.publishedDate)}</time>
        {showUpdated && (
          <>
            <span aria-hidden="true">·</span>
            <time datetime={iso(post.updatedDate)}>{d.blog.updated} {fmt(post.updatedDate)}</time>
          </>
        )}
        <span aria-hidden="true">·</span>
        <span>{minutes} {d.blog.readMin}</span>
      </p>
    </header>

    {cover && (
      <figure class="cover">
        <img class="pixel" src={cover.src} width={cover.attributes.width} height={cover.attributes.height} alt={post.imageAlt} fetchpriority="high" decoding="async" />
      </figure>
    )}

    {toc.length > 2 && (
      <nav class="toc" aria-labelledby="toc-title">
        <p id="toc-title" class="label">{d.blog.toc}</p>
        <ol>
          {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
        </ol>
      </nav>
    )}

    <div class="prose">
      <Content />
    </div>

    <aside class="author" aria-label={d.blog.by + ' ' + post.author}>
      <Image src={mascot} alt="" width={64} height={50} class="pixel" />
      <div>
        <p class="who">{post.author}</p>
        <p class="note">{d.blog.authorNote}</p>
      </div>
    </aside>

    <p class="back"><a href={path('blog', lang)}>← {d.blog.allArticles}</a></p>
  </article>
</Base>

<style>
  .art {
    max-width: 780px;
    padding-block: clamp(32px, 6vw, 72px);
  }
  .crumbs {
    display: flex;
    gap: 10px;
    font-size: 0.9375rem;
    color: var(--muted);
    margin-bottom: 28px;
  }
  .crumbs a {
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
  }
  .head h1 {
    font-size: clamp(2rem, 4.6vw, 3rem);
    margin: 10px 0 18px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.8125rem;
    color: var(--muted);
    padding-bottom: 24px;
    border-bottom: var(--border);
  }
  .cover {
    margin: 28px 0 0;
    border: var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    background: var(--tint-accent);
    overflow: hidden;
  }
  .cover {
    display: grid;
    place-items: center;
    padding: 28px 16px;
  }
  .cover img {
    width: min(100%, 240px);
    height: auto;
  }
  .toc {
    margin: 32px 0 0;
    padding: 20px 24px;
    border: var(--border);
    border-radius: var(--radius);
    background: var(--card);
  }
  .toc ol {
    margin: 10px 0 0;
    padding-left: 22px;
  }
  .toc li {
    margin-bottom: 6px;
  }
  .toc a {
    color: var(--text);
    text-underline-offset: 3px;
  }
  .toc a:hover {
    color: var(--accent);
  }
  .prose {
    margin-top: 36px;
  }
  .prose :global(h2) {
    font-size: clamp(1.5rem, 3vw, 1.875rem);
    margin: 48px 0 14px;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(table),
  .prose :global(blockquote) {
    margin: 0 0 18px;
  }
  .prose :global(li) {
    margin-bottom: 8px;
  }
  .prose :global(a) {
    color: var(--accent);
    font-weight: 600;
    text-underline-offset: 3px;
  }
  .prose :global(strong) {
    font-weight: 700;
  }
  .prose :global(img) {
    margin: 28px auto 8px;
    border-radius: var(--radius);
  }
  .prose :global(p > img + em) {
    display: block;
    text-align: center;
    font-size: 0.9375rem;
    font-style: normal;
    color: var(--muted);
    margin-bottom: 20px;
  }
  .prose :global(img[src$='.svg']) {
    width: 100%;
    max-width: 520px;
  }
  .prose :global(img[src*='/screens/']),
  .prose :global(img[src*='catat-id']),
  .prose :global(img[src*='catat-en']) {
    max-width: 320px;
    border: var(--border);
    box-shadow: var(--shadow);
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    border: var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--card);
    font-size: 0.975rem;
  }
  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: 12px 14px;
    vertical-align: top;
    border-bottom: 1px solid var(--divider);
  }
  .prose :global(th) {
    background: var(--tint-accent);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .prose :global(tr:last-child td) {
    border-bottom: 0;
  }
  .prose :global(blockquote) {
    padding: 14px 18px;
    border-left: 4px solid var(--accent);
    background: var(--tint-accent);
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .author {
    display: flex;
    gap: 18px;
    align-items: center;
    margin-top: 56px;
    padding: 20px 24px;
    border: var(--border);
    border-radius: var(--radius);
    background: var(--tint-accent);
  }
  .author .who {
    font-family: var(--font-display);
    font-weight: 700;
  }
  .author .note {
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .back {
    margin-top: 28px;
  }
  .back a {
    color: var(--accent);
    font-weight: 700;
    text-decoration: none;
  }
  @media (max-width: 520px) {
    .author {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
